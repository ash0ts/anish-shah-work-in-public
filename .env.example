# Comma-separated, exact-match email allowlist for /studio and all write APIs.
# Full provider setup and rotation: docs/play-connections.md
OWNER_EMAILS=anish@example.com

# Development only. This email must also appear in OWNER_EMAILS. The fallback
# works only with `npm run dev:studio` on localhost/127.0.0.1/[::1]; never
# configure it in Sites or another hosted environment.
LOCAL_OWNER_EMAIL=anish@example.com

# Base64-encoded 32-byte key used for AES-256-GCM connector encryption.
# `npm run setup:local` fills this only when it is blank or missing. It never
# prints or overwrites the value. Never copy it over the production key.
CONNECTOR_ENCRYPTION_KEY=

# Local-only HMAC salt for development request buckets. `npm run setup:local`
# generates it independently and restricts `.env.local` to mode 0600.
# Production uses a separate durable Cloudflare RATE_LIMIT_SALT secret.
RATE_LIMIT_SALT=

# Independent base64-encoded 32-byte HMAC key for opaque, short-lived Meet Me
# simulation sessions. `npm run setup:local` generates this key with the other
# local-only security values without printing or overwriting any of them.
SIMULATION_SESSION_HMAC_KEY=

# Local development uses deterministic authored fixtures and never calls an AI
# provider. Hosted staging/production values are generated by their guarded
# release contracts instead of being copied from this file.
SIMULATION_EXPERIENCE_MODE=campaign-v1
SIMULATION_AI_MODE=fixture
# Hosted environments always use Cloudflare AI Gateway. The local live-model
# launcher overrides this in memory with `direct-local`; do not persist a raw
# Anthropic key in this file or `.env.local`.
SIMULATION_AI_TRANSPORT=gateway
SIMULATION_PROVIDER=anthropic
SIMULATION_MODEL=claude-sonnet-5
SIMULATION_DAILY_MODEL_LIMIT=500

# Required before Steam credentials can be saved or synchronized. List the
# actual country or countries where sanitized Steam snapshots are stored.
STEAM_DATA_STORAGE_COUNTRIES=United States

# Used to construct absolute server-side URLs. MyAnimeList and Spotify OAuth
# credentials and Strava embeds are entered through Studio, never this file.
SITE_URL=http://localhost:3000

# Exact owner-controlled HTTPS origin used only by the local Studio's
# one-time, server-to-server Play promotion flow. The transfer code must name
# the same origin. Never point this at an arbitrary host.
PRODUCTION_SITE_URL=https://anish-shah-is.online

# Connector provider credentials are deliberately not read from environment variables.
# Enter MyAnimeList, Hardcover, Spotify, Steam, and Strava configuration through the
# protected local Studio so credentials are encrypted and changes are audited.
