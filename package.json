{
  "name": "anish-shah-work-in-public",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "dev:studio": "npm run db:local:migrate && npm run dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "typecheck": "tsc --noEmit",
    "verify:content": "node scripts/build-content.mjs --check",
    "test:content": "node --test tests/content-pipeline.test.mjs tests/content-privacy.test.mjs tests/content-connectors.test.mjs tests/content-connector-gallery.test.mjs tests/content-myanimelist-oauth.test.mjs tests/content-steam-connector.test.mjs tests/content-workgroups.test.mjs tests/bodies-of-work.test.mjs tests/work-facets.test.mjs tests/work-archive-v12.test.mjs",
    "test:backend": "node --test tests/backend-security.test.mjs tests/backend-public-content.test.mjs tests/backend-connector-privacy.test.mjs tests/content-strava-config.test.mjs",
    "test:rendered": "node --test tests/rendered-html.test.mjs && node --test tests/redesign-acceptance.test.mjs",
    "test": "npm run typecheck && npm run test:content && npm run test:backend && npm run build && npm run test:rendered",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "brand:assets": "node scripts/generate-favicon.mjs",
    "db:generate": "drizzle-kit generate",
    "db:local:migrate": "node scripts/apply-local-d1-migrations.mjs"
  },
  "dependencies": {
    "animejs": "4.5.0",
    "drizzle-orm": "0.45.2",
    "next": "16.2.12",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "sharp": "0.35.3",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "type": "module"
}
