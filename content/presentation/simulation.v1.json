  "fallbackDialogue": [
    { "id": "fallback:act-1:trace", "opponentLine": "A system is not a label. Trace what it connects before naming it.", "responseMode": "probe", "revealEntityIds": ["group:products:wandb-mcp"], "visitorSignals": ["systems-thinking"] },
    { "id": "fallback:act-1:people", "opponentLine": "Public work travels through classrooms, collaborators, and communities—not only repositories.", "responseMode": "counter", "revealEntityIds": ["group:courses:ai-curriculum"], "visitorSignals": ["teaching", "community"] },
    { "id": "fallback:act-1:artifact", "opponentLine": "Good. Inspect the artifact before accepting the summary.", "responseMode": "acknowledge", "revealEntityIds": ["group:writing:wandbot"], "visitorSignals": ["evaluation-rigor"] },
    { "id": "fallback:act-2:probe", "opponentLine": "The first answer is a hypothesis. Ask what would make it fail.", "responseMode": "probe", "revealEntityIds": ["group:products:evalforge"], "visitorSignals": ["evaluation-rigor"] },
    { "id": "fallback:act-2:trace", "opponentLine": "Follow the claim back to the workshop, implementation, or recording that can support it.", "responseMode": "acknowledge", "revealEntityIds": ["group:courses:agentic-llm-series"], "visitorSignals": ["evaluation-rigor", "systems-thinking"] },
    { "id": "fallback:act-2:qualify", "opponentLine": "A qualifier is not a weakness. It is part of the measurement.", "responseMode": "counter", "revealEntityIds": ["group:talks:building-evaluating-agents"], "visitorSignals": ["evaluation-rigor"] },
    { "id": "fallback:act-2:reframe", "opponentLine": "Better question: which feedback loop made the work more useful?", "responseMode": "redirect", "revealEntityIds": ["group:products:evalforge"], "visitorSignals": ["playful-curiosity"] },
    { "id": "fallback:act-3:watch", "opponentLine": "Watch is a doorway, not a personality test. Keep the connection curious and provisional.", "responseMode": "acknowledge", "revealEntityIds": ["group:writing:prompt-engineering-langchain"], "visitorSignals": ["playful-curiosity"] },
    { "id": "fallback:act-3:read", "opponentLine": "Reading can open a question. It cannot prove a private belief.", "responseMode": "counter", "revealEntityIds": ["group:writing:automated-pdf-summarization"], "visitorSignals": ["playful-curiosity"] },
    { "id": "fallback:act-3:listen", "opponentLine": "A listening shelf adds texture without becoming an inferred profile.", "responseMode": "acknowledge", "revealEntityIds": ["group:courses:startup-school"], "visitorSignals": ["playful-curiosity"] },
    { "id": "fallback:act-3:collect", "opponentLine": "A physical archive rewards close inspection. So does public technical work.", "responseMode": "probe", "revealEntityIds": ["group:products:lightning-fabric"], "visitorSignals": ["open-source", "playful-curiosity"] },
    { "id": "fallback:act-3:play", "opponentLine": "Play is another system to learn—not evidence for a neat personality label.", "responseMode": "counter", "revealEntityIds": ["group:products:lightning-fabric"], "visitorSignals": ["systems-thinking", "playful-curiosity"] },
    { "id": "fallback:act-3:move", "opponentLine": "Movement is a public doorway here, not a dataset for guessing motives.", "responseMode": "redirect", "revealEntityIds": ["group:courses:startup-school"], "visitorSignals": ["playful-curiosity"] },
    { "id": "fallback:boss:ground", "opponentLine": "Grounded. The approximation loses confidence when the artifact stays attached.", "responseMode": "acknowledge", "revealEntityIds": ["group:products:wandb-mcp", "group:writing:wandbot"], "visitorSignals": ["evaluation-rigor"] },
    { "id": "fallback:boss:qualify", "opponentLine": "Qualifier retained. Precision survives the compression attempt.", "responseMode": "acknowledge", "revealEntityIds": ["group:products:evalforge", "group:courses:ai-curriculum"], "visitorSignals": ["evaluation-rigor", "teaching"] },
